# ---------- БАЛАНС, ПОЛЬЗОВАТЕЛИ ----------
def get_user(user_id):
    with db_lock:
        conn = sqlite3.connect("users.db")
        c = conn.cursor()
        c.execute("SELECT balance, total_generated, referrer_id, ref_code FROM users WHERE user_id = ?", (user_id,))
        row = c.fetchone()
        conn.close()
        return row

def create_user(user_id, referrer_id=None):
    with db_lock:
        conn = sqlite3.connect("users.db")
        c = conn.cursor()
        ref_code = ''.join(random.choices(string.ascii_letters + string.digits, k=8))
        c.execute("INSERT INTO users (user_id, balance, total_generated, referrer_id, ref_code) VALUES (?, ?, ?, ?, ?)",
                  (user_id, FREE_START, 0, referrer_id, ref_code))
        conn.commit()
        conn.close()
    if referrer_id:
        add_balance(referrer_id, REFERRAL_BONUS)
        add_balance(user_id, REFERRAL_BONUS)
        try:
            bot.send_message(referrer_id, f"🎉 По вашей ссылке пришёл друг! +{REFERRAL_BONUS} кредитов.")
        except:
            pass

def add_balance(user_id, delta):
    with db_lock:
        conn = sqlite3.connect("users.db")
        c = conn.cursor()
        c.execute("UPDATE users SET balance = balance + ? WHERE user_id = ?", (delta, user_id))
        if c.rowcount == 0:
            c.execute("INSERT INTO users (user_id, balance) VALUES (?, ?)", (user_id, delta))
        conn.commit()
        conn.close()

def get_balance(user_id):
    if user_id in ADMIN_IDS:
        return float('inf')
    row = get_user(user_id)
    if row is None:
        create_user(user_id)
        return FREE_START
    return row[0]

def use_credits(user_id, cost):
    if user_id in ADMIN_IDS:
        with db_lock:
            conn = sqlite3.connect("users.db")
            c = conn.cursor()
            c.execute("UPDATE users SET total_generated = total_generated + 1 WHERE user_id = ?", (user_id,))
            if c.rowcount == 0:
                c.execute("INSERT INTO users (user_id, balance, total_generated) VALUES (?, ?, ?)", (user_id, FREE_START, 1))
            conn.commit()
            conn.close()
        return True
    with db_lock:
        conn = sqlite3.connect("users.db")
        c = conn.cursor()
        c.execute("SELECT balance FROM users WHERE user_id = ?", (user_id,))
        row = c.fetchone()
        if not row or row[0] < cost:
            conn.close()
            return False
        c.execute("UPDATE users SET balance = balance - ?, total_generated = total_generated + 1 WHERE user_id = ?", (cost, user_id))
        conn.commit()
        conn.close()
    return True

def get_ref_code(user_id):
    row = get_user(user_id)
    if row and row[3]:
        return row[3]
    with db_lock:
        conn = sqlite3.connect("users.db")
        c = conn.cursor()
        code = ''.join(random.choices(string.ascii_letters + string.digits, k=8))
        c.execute("UPDATE users SET ref_code = ? WHERE user_id = ?", (code, user_id))
        conn.commit()
        conn.close()
    return code

def get_total_generated(user_id):
    row = get_user(user_id)
    return row[1] if row else 0

def get_all_stats():
    with db_lock:
        conn = sqlite3.connect("users.db")
        c = conn.cursor()
        c.execute("SELECT COUNT(*) FROM users")
        total_users = c.fetchone()[0]
        c.execute("SELECT SUM(total_generated) FROM users")
        total_gens = c.fetchone()[0] or 0
        conn.close()
    return total_users, total_gens

def check_rate_limit(user_id):
    now = time.time()
    last = user_last_request.get(user_id, 0)
    if now - last < RATE_LIMIT:
        return False
    user_last_request[user_id] = now
    return True

