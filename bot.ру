# ---------- БАЗА ДАННЫХ ----------
def init_db():
    with db_lock:
        conn = sqlite3.connect("users.db")
        c = conn.cursor()
        c.execute('''CREATE TABLE IF NOT EXISTS users
                     (user_id INTEGER PRIMARY KEY,
                      balance INTEGER DEFAULT 0,
                      total_generated INTEGER DEFAULT 0,
                      referrer_id INTEGER DEFAULT NULL,
                      ref_code TEXT UNIQUE,
                      last_daily TEXT)''')
        try:
            c.execute("ALTER TABLE users ADD COLUMN last_daily TEXT")
        except sqlite3.OperationalError:
            pass
        c.execute('''CREATE TABLE IF NOT EXISTS history
                     (id INTEGER PRIMARY KEY AUTOINCREMENT,
                      user_id INTEGER,
                      prompt TEXT,
                      image_data BLOB,
                      size TEXT,
                      timestamp REAL)''')
        conn.commit()
        conn.close()

def save_to_history(user_id, prompt, image_bytes, size):
    with db_lock:
        conn = sqlite3.connect("users.db")
        c = conn.cursor()
        c.execute("INSERT INTO history (user_id, prompt, image_data, size, timestamp) VALUES (?, ?, ?, ?, ?)",
                  (user_id, prompt, image_bytes, size, time.time()))
        conn.commit()
        conn.close()

# ---------- ЕЖЕДНЕВНЫЙ БОНУС ----------
def daily_bonus(user_id):
    today = datetime.date.today().isoformat()
    with db_lock:
        conn = sqlite3.connect("users.db")
        c = conn.cursor()
        c.execute("SELECT last_daily FROM users WHERE user_id = ?", (user_id,))
        row = c.fetchone()
        if row is None or row[0] != today:
            c.execute("UPDATE users SET balance = balance + 5, last_daily = ? WHERE user_id = ?", (today, user_id))
            conn.commit()
            conn.close()
            return True
        conn.close()
        return False

