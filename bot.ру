def generate_with_size(message, size, user_id):
    prompt = message.text.strip()
    if not prompt:
        bot.reply_to(message, "Напишите описание.")
        return
    if not check_rate_limit(user_id):
        bot.reply_to(message, tr(user_id, "rate_limit", RATE_LIMIT))
        return
    if not use_credits(user_id, PRICE_IMAGE):
        bal = get_balance(user_id)
        bot.reply_to(message, tr(user_id, "not_enough_credits", PRICE_IMAGE, bal))
        return
    status_msg = bot.reply_to(message, f"✨ Генерирую {size}: {prompt}")
    threading.Thread(target=generate_and_send_image, args=(message, prompt, user_id, status_msg, size)).start()

def admin_give_credits_step(message):
    user_id = message.from_user.id
    if user_id not in ADMIN_IDS:
        return
    try:
        parts = message.text.strip().split()
        target_id = int(parts[0])
        amount = int(parts[1])
        if amount <= 0 or amount > 10000:
            bot.reply_to(message, tr(user_id, "invalid_format"))
            return
        add_balance(target_id, amount)
        bot.reply_to(message, tr(user_id, "given_credits", amount, target_id))
        bot.send_message(target_id, f"🎁 Администратор выдал вам {amount} кредитов!")
    except:
        bot.reply_to(message, tr(user_id, "invalid_format"))
    bot.send_message(message.chat.id, tr(user_id, "menu"), reply_markup=inline_menu(user_id))

