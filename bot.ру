# ---------- ГЕНЕРАЦИЯ КАРТИНОК ----------
def generate_image_pollinations(prompt, size):
    enhanced = enhance_prompt(prompt)
    url = f"https://image.pollinations.ai/prompt/{requests.utils.quote(enhanced)}?model=turbo&nologo=true"
    if size == "512x512":
        url += "&width=512&height=512"
    elif size == "1024x1024":
        url += "&width=1024&height=1024"
    elif size == "1920x1080":
        url += "&width=1920&height=1080"
    try:
        resp = requests.get(url, timeout=60)
        if resp.status_code == 200:
            return resp.content
        else:
            print(f"Pollinations error: {resp.status_code}")
            return None
    except Exception as e:
        print(f"Pollinations exception: {e}")
        return None

# ---------- АНИМАЦИЯ ЗАРЯДКИ БАТАРЕИ ----------
def animate_loading_battery(message, text):
    frames = [
        ("🔋", 10),
        ("🔋", 25),
        ("🔋", 50),
        ("🔋", 75),
        ("🔋", 90),
        ("⚡", 100)
    ]
    for icon, percent in frames:
        filled = percent // 10
        bar = "█" * filled + "░" * (10 - filled)
        loading_text = f"{text}\n\n{icon} Зарядка: [{bar}] {percent}%"
        if percent == 100:
            loading_text = f"{text}\n\n✅ **Готово!**"
        try:
            bot.edit_message_text(loading_text,
                                  chat_id=message.chat.id,
                                  message_id=message.message_id,
                                  parse_mode="Markdown")
        except:
            pass
        time.sleep(3.0)

